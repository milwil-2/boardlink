    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "license": "MIT",
  "author": "milwil-2",
  "keywords": ["climbing", "kilter", "tension", "moonboard", "logbook", "board"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milwil-2/boardlink.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/milwil-2/boardlink#readme",
  "bugs": "https://github.com/milwil-2/boardlink/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
