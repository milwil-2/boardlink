{
  "name": "@boardlink/server",
  "version": "0.1.0",
  "description": "Thin HTTP wrapper over @boardlink/core: POST /:board -> normalized logbook.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "boardlink-server": "./dist/cli.js"
  },
  "files": ["dist"],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boardlink/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
